    "kawaraban": "topic-cluster source (news mirror; verdict 不可の MEDIUM) — mikurabe reads ONLY kawaraban's already-public :mirror articles, grouped by kawaraban's own existing mention-edge/section-route graph; never re-fetches an outlet itself",
    "kouhou": "briefing source (government-PR curator, PublicInfoGovernor-gated) — mikurabe reads ONLY kouhou's already-public briefings on the same official announcement",
    "danjo": "sibling non-adjudicating discipline (G3 passive-only ingestion + G4 non-adjudicating) mikurabe's passive-only-input design and :event-truth-verdict gate mirror",
    "ooyake": "sibling government-ranking ban (G11: 'do not rank governments or take a political position — descriptive, neutral') mikurabe's :country-or-outlet-verdict gate mirrors EXACTLY, made concrete and schema-enforced for narrative comparison",
    "tashikame": "citation-grounded conclusive-observation precedent (uncited-conclusive HARD-hold) mikurabe continues, scoped down from single-claim fact-check to per-topic-cluster framing-technique comparison"
  },
  "scope": {
    "phase": "R0 scaffold only — mock-advisor + mock-publisher + fixture-only tests; NO live kawaraban/kouhou data ever read; NO named-party report ever published",
    "scopeBoundary": "per-topic-cluster comparative narrative-framing observation (how differently N already-public accounts described the SAME story) — never a standing verdict about a country/government/outlet",
    "exclusions": [
      "standing country/government/outlet credibility, rank, or regime-type scoring (schema-unrepresentable at every layer — governor + lexicon; mirrors ooyake G11)",
      "underlying-event truth verdicts (mirrors kawaraban G1 + danjo G4)",
      "autonomous named-party publication (Council Lv6+ + SBT-vote gated, R2+; default phase is 0/observe — nothing auto-publishes at R0/R1 regardless of named-party status)",
      "actuation (funds/access/physical — publication ≠ actuation)"
    ]
  },
  "constitutionalDiscipline": {
    "citationGrounded": "every published observation cites ≥2 of the compared items' own excerpts (tashikame precedent, continued and made mandatory with no exception)",
    "passiveOnlyIngestion": "mikurabe never fetches an outlet/government site itself — downstream consumer of kawaraban's/kouhou's own already-public output only (danjo G3 discipline)",
    "noStandingEntityVerdict": "no field may score/rank/label a country, government, or outlet as a standing entity — schema-level unrepresentable in both the NarrativeGovernor (structural key-scan, proven by a poisoned-fixture test) and the frameObservation lexicon (const-false fields), mirrors ooyake G11 exactly",
    "noEventVerdict": "no field may assert what actually happened in the underlying event — mikurabe compares framing, never adjudicates truth (mirrors kawaraban G1 + danjo G4)",
