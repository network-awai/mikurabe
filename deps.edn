{:paths ["src"]
 ;; kotoba-lang/langgraph brings kotoba-lang/langchain transitively (both
 ;; zero-/single-dep, all .cljc → portable to JVM / SCI / ClojureScript /
 ;; GraalVM).
 ;;
 ;; NOTE on the path below vs. sibling actors' deps.edn: tashikame's and
 ;; yosoku's own deps.edn still say `io.github.com-junkawasaki/langgraph-clj`
 ;; at `../../com-junkawasaki/langgraph-clj` — that checkout is retired
 ;; locally (see `.git/orphan-retire-archive-20260717/
 ;; orgs_com-junkawasaki_langgraph-clj.meta.txt`: "class=successor-leftover
 ;; maps_to=orgs/kotoba-lang/langgraph"). The repo itself was renamed/moved
 ;; to `kotoba-lang/langgraph` (root CLAUDE.md "Repo naming — no -clj
 ;; suffix"); GitHub confirms `com-junkawasaki/langgraph-clj` now redirects
 ;; to `kotoba-lang/langgraph`. mikurabe is a NEW registration, so it points
 ;; at the CURRENT canonical coordinates instead of perpetuating the stale
 ;; path (same for langchain below).
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/data.json {:mvn/version "2.5.1"} ; aozora publish + LLM json
        io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}}
 :aliases
 {;; offline workspace dev — pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; clojure -M:dev:run → drive representative topic-cluster proposals
  ;; through the actor (mock advisor + mock publisher, no network)
  :run {:main-opts ["-m" "mikurabe.sim"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}
